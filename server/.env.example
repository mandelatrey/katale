# Copy this file to .env and fill in your values.
# server/.env is gitignored — never commit real credentials.

# MongoDB connection string.
# Local:  mongodb://localhost:27017/uganda-markets
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/uganda-markets
MONGODB_URI=mongodb://localhost:27017/uganda-markets

# WhatsApp AI middleware (set both to enable Gemini-powered responses)
WHATSAPP_AI_MIDDLEWARE=1
GEMINI_API_KEY=

# WhatsApp provider — Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# WhatsApp provider — Meta Cloud API
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=

# Ngrok (optional, for local tunnel)
NGROK_AUTHTOKEN=
